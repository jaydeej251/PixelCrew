# Database (local dev uses your macOS user; Docker uses agenthq:agenthq)
DATABASE_URL="postgresql://markdjjunio@localhost:5432/agenthq?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PRODUCT_NAME="PixelCrew"

# Encryption for stored API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="change-me-to-a-64-char-hex-string"

# Inngest (optional for local dev)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Provider keys — NEVER commit real values. Use .env.local only.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"

# Auth (Phase 4)
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (Phase 4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
