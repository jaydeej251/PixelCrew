generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  idle
  walking
  working
  blocked
  error
  handoff
}

enum RunStatus {
  pending
  running
  paused
  completed
  cancelled
  failed
}

enum TaskStatus {
  queued
  claimed
  in_progress
  blocked
  done
  failed
}

enum EventType {
  TASK_CLAIMED
  TASK_STARTED
  AGENT_THINKING
  AGENT_HANDOFF
  AGENT_BLOCKED
  AGENT_ERROR
  AGENT_TASK_DONE
  RUN_COMPLETED
  RUN_CANCELLED
  EXECUTION_STARTED
  TOOL_STARTED
  TOOL_COMPLETED
  TOOL_FAILED
  CHECK_PASSED
  CHECK_FAILED
  APPROVAL_REQUIRED
  APPROVAL_RESOLVED
  DIFF_READY
  EXECUTION_COMPLETED
  SANDBOX_TERMINATED
}

enum ExecutionStatus {
  pending
  running
  paused
  completed
  failed
  cancelled
}

enum AttemptStatus {
  starting
  running
  completed
  failed
  cancelled
}

enum ToolEventStatus {
  requested
  running
  completed
  failed
}

enum CheckStatus {
  pending
  passed
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

enum RunEventSourceKind {
  execution
  attempt
  tool_event
  check_result
  approval
}

enum ProviderType {
  mock
  openai_compatible
  openrouter
  google
  ollama
  anthropic
}

enum ArtifactType {
  prd
  task_list
  architecture
  code
  test_plan
  other
}

enum MembershipRole {
  owner
  admin
  member
}

enum PlatformRole {
  none
  ops
  owner
}

enum PlanTier {
  free
  pro
  enterprise
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String?
  passwordHash       String?
  platformRole       PlatformRole    @default(none)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  memberships        Membership[]
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  requestedApprovals Approval[]      @relation("ApprovalRequestedBy")
  resolvedApprovals  Approval[]      @relation("ApprovalResolvedBy")
  adminAuditLogs     AdminAuditLog[]
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  plan        PlanTier     @default(free)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  workspaces  Workspace[]
  usageEvents UsageEvent[]
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(member)
  userId         String
  organizationId String
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id             String               @id @default(cuid())
  name           String
  organizationId String
  ceoGoal        String?
  concurrencyCap Int                  @default(3)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    Department[]
  agents         Agent[]
  desks          Desk[]
  runs           Run[]
  credentials    ProviderCredential[]
  memories       WorkspaceMemory[]
  officeLayouts  OfficeLayout[]
}

model Department {
  id          String    @id @default(cuid())
  name        String
  workspaceId String
  color       String    @default("#6366f1")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents      Agent[]
}

model Desk {
  id          String    @id @default(cuid())
  label       String
  x           Int
  y           Int
  room        String
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents      Agent[]

  @@unique([workspaceId, x, y])
}

model OfficeLayout {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  data        Json
  isActive    Boolean   @default(false)
  // Built-in HQ: cannot delete; restore resets to factory plan
  isProtected Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model Agent {
  id            String        @id @default(cuid())
  name          String
  position      String
  positionLabel String
  jobBoundary   String
  avatarColor   String        @default("#8b5cf6")
  status        AgentStatus   @default(idle)
  provider      ProviderType  @default(mock)
  model         String        @default("mock")
  workspaceId   String
  departmentId  String?
  deskId        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  desk          Desk?         @relation(fields: [deskId], references: [id], onDelete: SetNull)
  claimedTasks  Task[]        @relation("ClaimedBy")
  events        RunEvent[]
  memories      AgentMemory[]
  executions    Execution[]
  attempts      Attempt[]
}

model ProviderCredential {
  id           String       @id @default(cuid())
  workspaceId  String
  provider     ProviderType
  label        String
  encryptedKey String?
  baseUrl      String?
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Run {
  id           String        @id @default(cuid())
  workspaceId  String
  ceoGoal      String
  title        String        @default("")
  status       RunStatus     @default(pending)
  startedAt    DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  totalTokens  Int           @default(0)
  estCostUsd   Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks        Task[]
  events       RunEvent[]
  artifacts    Artifact[]
  usageEvents  UsageEvent[]
  workflow     Workflow?
  executions   Execution[]
  attempts     Attempt[]
  toolEvents   ToolEvent[]
  checkResults CheckResult[]
  approvals    Approval[]
}

model Workflow {
  id        String   @id @default(cuid())
  runId     String   @unique
  graph     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Task {
  id           String        @id @default(cuid())
  runId        String
  title        String
  description  String?
  position     String
  status       TaskStatus    @default(queued)
  priority     Int           @default(0)
  dependsOnIds String[]      @default([])
  claimedById  String?
  claimedAt    DateTime?
  completedAt  DateTime?
  output       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  run          Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  claimedBy    Agent?        @relation("ClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  execution    Execution?
  attempts     Attempt[]
  toolEvents   ToolEvent[]
  checkResults CheckResult[]
  approvals    Approval[]
}

model RunEvent {
  id         String              @id @default(cuid())
  runId      String
  agentId    String?
  type       EventType
  payload    Json                @default("{}")
  sourceKind RunEventSourceKind?
  sourceId   String?
  createdAt  DateTime            @default(now())
  run        Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent      Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([runId, sourceKind, sourceId, type])
  @@index([runId, createdAt])
}

model Execution {
  id             String          @id @default(cuid())
  runId          String
  taskId         String          @unique
  agentId        String?
  idempotencyKey String          @unique
  status         ExecutionStatus @default(pending)
  attemptCounter Int             @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  lastError      String?         @db.VarChar(8000)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent          Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  attempts       Attempt[]
  approvals      Approval[]

  @@index([runId, status])
}

model Attempt {
  id                  String        @id @default(cuid())
  executionId         String
  runId               String
  taskId              String
  agentId             String?
  sequence            Int
  idempotencyKey      String        @unique
  status              AttemptStatus @default(starting)
  workspaceKey        String?       @db.VarChar(512)
  toolSequenceCounter Int           @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  error               String?       @db.VarChar(8000)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  execution           Execution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  run                 Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  task                Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent               Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  toolEvents          ToolEvent[]
  checkResults        CheckResult[]
  approvals           Approval[]

  @@unique([executionId, sequence])
  @@index([runId, status])
}

model ToolEvent {
  id             String          @id @default(cuid())
  attemptId      String
  runId          String
  taskId         String
  sequence       Int
  idempotencyKey String          @unique
  toolName       String          @db.VarChar(200)
  status         ToolEventStatus @default(requested)
  input          Json?
  output         Json?
  error          String?         @db.VarChar(8000)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attempt        Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  run            Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sequence])
  @@index([runId, status])
}

model CheckResult {
  id             String      @id @default(cuid())
  attemptId      String
  runId          String
  taskId         String
  idempotencyKey String      @unique
  checkName      String      @db.VarChar(200)
  status         CheckStatus @default(pending)
  summary        String?     @db.VarChar(8000)
  details        Json?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  attempt        Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  run            Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  task           Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([runId, status])
}

model Approval {
  id             String         @id @default(cuid())
  executionId    String
  attemptId      String?
  runId          String
  taskId         String
  idempotencyKey String         @unique
  status         ApprovalStatus @default(pending)
  kind           String         @db.VarChar(200)
  prompt         String         @db.VarChar(8000)
  decisionNote   String?        @db.VarChar(8000)
  requestedById  String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  execution      Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  attempt        Attempt?       @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  run            Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy    User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  resolvedBy     User?          @relation("ApprovalResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([runId, status])
}

model Artifact {
  id        String       @id @default(cuid())
  runId     String
  type      ArtifactType
  title     String
  content   String
  filePath  String?
  createdAt DateTime     @default(now())
  run       Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  runId          String?
  provider       ProviderType
  model          String
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  estCostUsd     Float        @default(0)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run            Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)
}

model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  runId     String?
  content   String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model WorkspaceMemory {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
